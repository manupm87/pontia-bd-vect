# Copia este archivo como .env y ajusta solo lo que necesites. No añadas secretos al repositorio.
HF_TOKEN=
QDRANT_API_KEY=

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=aurum-market-eval-catalogo
QDRANT_EVENTS_COLLECTION=aurum-market-eval-eventos

# Interruptores de seguridad: desactivados por defecto.
# AURUM_ALLOW_RESET habilita recrear una colección existente desde cero.
# AURUM_CONFIRM_CLEANUP exige la confirmación exacta "DELETE:<coleccion>" para borrarla.
AURUM_ALLOW_RESET=false
AURUM_CONFIRM_CLEANUP=
