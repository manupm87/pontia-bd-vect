# Modelo y contrato heredados de las sesiones 1 y 2
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Pinecone Cloud (único servicio cloud obligatorio del recorrido)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=bbdd-vectoriales-s03-products
PINECONE_NAMESPACE=esci-es-s03
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Servicios locales. Los compose publicados exponen estos valores por defecto.
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=bbdd-vectoriales-s03-chroma
WEAVIATE_HOST=localhost
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051
WEAVIATE_COLLECTION=BbddVectorialesS03Products
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=bbdd_vectoriales_s03_milvus
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=bbdd-vectoriales-s03-qdrant

# Seguridad: una recreación o limpieza nunca se habilita de manera implícita.
S03_ALLOW_RESET=false
S03_ALLOW_REMOTE_CLEANUP=false
# Limpieza destructiva de un laboratorio: dejar vacío para mantenerla desactivada.
S03_CONFIRM_CLEANUP=
